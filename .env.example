# 이 파일을 복사해 .env를 만들고 값을 채운다 (.env는 커밋되지 않는다)

# true: 백엔드 없이 더미 데이터로 실행 (시연용, 자동 로그인)
# false: VITE_API_URL의 실제 백엔드 서버 사용
VITE_USE_MOCK=true

# 백엔드 서버 주소 (VITE_USE_MOCK=false일 때 사용)
VITE_API_URL=

# 식품안전나라 조리식품 레시피 DB(COOKRCP01) 인증키
VITE_FOOD_API_KEY=

# Google AI Studio에서 발급한 Gemini API 키 (결제를 연결하지 않은 무료 키 권장)
VITE_GEMINI_API_KEY=